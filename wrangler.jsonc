{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "presensi-ai-mahasiswa",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "presensi-ai-mahasiswa-db",
      "database_id": "a29ececf-9447-4ebc-89a0-e92e4d44a50f"
    }
  ]
}
